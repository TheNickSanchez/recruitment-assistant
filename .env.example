# LLM provider / OpenAI-compatible gateway
# Option A — native OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o
# Option B — LiteLLM proxy (or any OpenAI-compatible gateway):
#   OPENAI_API_KEY=<litellm virtual key>
#   OPENAI_BASE_URL=http://localhost:4000   # /v1 is appended automatically if missing
#   OPENAI_MODEL=<model id your proxy exposes, e.g. claude-sonnet-4-6>
# Cursor API keys (crsr_...) are NOT supported here — they are Cloud Agents
# keys, not chat-completions keys. If your IDE injects OPENAI_API_KEY=crsr_...,
# put the LiteLLM key in LITELLM_API_KEY or rely on app load_dotenv(override=True).
OPENAI_API_KEY=your_openai_or_litellm_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=your_litellm_virtual_key_here
   
# AAMAD runtime target (default for this course)
AAMAD_TARGET_RUNTIME=crewai
   
# Application Configuration
APP_NAME="Recruitment Assistant"
APP_ENV=development
   
# CrewAI Configuration (if needed)
CREWAI_TELEMETRY_OPT_OUT=true

# Application logging (stdout always). File: project-context/2.build/logs/app.log
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Opt-in CrewAI AMP tracing. Requires `crewai login` and a free app.crewai.com
# account. When true, RecruitmentCrew is constructed with tracing=True and
# prompts/tool I/O (including candidate data) are sent to CrewAI AMP.
# Leave false unless you have reviewed that data-sharing.
CREWAI_TRACING_ENABLED=false

# Web search/scrape tool (SerperDevTool backing provider) - required by the
# researcher/evaluator/recommender agents' tool set (backend.md)
SERPER_API_KEY=your_serper_api_key_here
